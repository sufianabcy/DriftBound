# Copy to .env for local development. Leave DATABASE_URL empty to use a local
# SQLite file (driftbound.db); set it to reach RDS through an SSH tunnel:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/driftbound?ssl=require
DATABASE_URL=
# Leave empty to keep robust-mode model snapshots in ./models instead of S3.
MODELS_BUCKET=
AWS_REGION=ap-south-1
