# Template for /etc/driftbound.env on the EC2 instance (root-only, mode 600).
# Fill in real values there; never commit them. URL-encode special characters
# in the password (for example @ becomes %40).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@RDS-ENDPOINT:5432/driftbound?ssl=require
MODELS_BUCKET=driftbound-models-CHANGE-ME
AWS_REGION=ap-south-1
